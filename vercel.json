{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "buildCommand": "npm run build",
  "outputDirectory": "dist/epoch-front/browser",
  "functions": {
    "api/index.mjs": { "includeFiles": "dist/epoch-front/**" }
  },
  "rewrites": [
    { "source": "/", "destination": "/api" },
    { "source": "/(.*)", "destination": "/api" }
  ]
}
